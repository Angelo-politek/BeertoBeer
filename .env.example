# Beer to Beer — variabili d'ambiente
# Copia questo file in ".env" e inserisci i valori reali del tuo progetto Supabase.
# I valori si trovano nel dashboard: Project Settings -> API.
# Il prefisso EXPO_PUBLIC_ è richiesto da Expo per rendere le variabili leggibili dall'app.
# L'anon key è una chiave PUBBLICA (protetta da Row Level Security): può stare nel client.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

{
  "expo": {
    "name": "Beer to Beer",
    "slug": "beer-to-beer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beertobeer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090909",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.quantumalbe.beertobeer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/3983baf5-d755-4e7f-b03c-1d09593cd22b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Beer to Beer usa la tua posizione per mostrare le consegne vicine e calcolare la distanza."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Beer to Beer accede alle tue foto per impostare l'immagine del profilo.",
          "cameraPermission": "Beer to Beer usa la fotocamera per scattare la foto del profilo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C77D0E",
          "defaultChannel": "messages"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3983baf5-d755-4e7f-b03c-1d09593cd22b"
      }
    },
    "owner": "angelopolitek"
  }
}
